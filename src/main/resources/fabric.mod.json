{
  "schemaVersion": 1,
  "id": "cobweb",
  "version": "1.0.5",
  "name": "Cobweb Placement Optimizer",
  "description": "Place a cobweb where you aim with one keyboard or mouse button, then return to your previous hotbar slot after an adjustable delay. Customize placed cobwebs with a color picker, #RRGGBB hex colors, and a pulsing shimmer.",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.cobweb.CobwebClient"
    ],
    "modmenu": [
      "dev.cobweb.CobwebModMenu"
    ]
  },
  "license": "MIT",
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "=1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "icon": "assets/cobweb/icon.png",
  "contact": {
    "homepage": "https://github.com/082-0/cobweb-placement-optimizer",
    "issues": "https://github.com/082-0/cobweb-placement-optimizer/issues",
    "sources": "https://github.com/082-0/cobweb-placement-optimizer"
  }
}
